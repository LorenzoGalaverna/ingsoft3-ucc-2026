server {
    listen 80;

    # SPA: estáticos, con fallback a index.html para las rutas del router
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # La dirección del backend y el DNS llegan por variables de entorno: en compose,
    # el nombre del servicio y el DNS de Docker; en Render, la URL pública de la api
    # de ESTE entorno y un DNS público. La imagen oficial de nginx procesa los
    # archivos de /etc/nginx/templates/ con envsubst al arrancar y reemplaza
    # ${VARIABLE} por su valor, dejando el conf final en /etc/nginx/conf.d/.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # la api de Render es https: sin esto el TLS
                                    # no sabe a qué host apuntar el SNI y falla
    }
}
